// ────────────── Startup Applications ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Miscellaneous#spawn-sh-at-startup

    // Calls a Script in bin that makes sure that the kwall
    // Gets unlocked
    //Starts Noctalia
    spawn-at-startup "noctalia"
    spawn-sh-at-startup "exec /usr/lib/pam_kwallet_init"
